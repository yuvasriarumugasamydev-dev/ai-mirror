# Pick one provider: colab_free uses COLAB_BACKEND_URL; huggingface uses HF_TRYON_API_URL.
AI_PROVIDER=huggingface

# Colab notebook tunnel URL (base URL or a URL already ending in /tryon).
COLAB_BACKEND_URL=https://your-colab-tunnel.example

# URL where api/app.py is deployed, including the /tryon path.
HF_TRYON_API_URL=https://your-api-host.example/tryon
